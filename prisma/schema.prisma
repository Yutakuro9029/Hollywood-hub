generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model actors {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  /// รหัสบุคคลใน TMDB — ใช้ upsert ตอน seed ให้รันซ้ำได้โดยไม่สร้างแถวซ้ำ
  tmdb_id      Int?         @unique(map: "uq_actors_tmdb") @db.UnsignedInt
  name         String       @db.VarChar(120)
  nationality  String?      @db.VarChar(60)
  birth_date   DateTime?    @db.Date
  bio          String?      @db.Text
  avatar_url   String?      @db.VarChar(500)
  /// จำนวนรางวัลที่ได้รับ (Wikidata P166) — null = ไม่มีข้อมูล (ไม่ใช่ 0 รางวัล)
  awards_count Int?         @db.UnsignedInt
  created_at   DateTime     @default(now()) @db.Timestamp(0)
  credits      movie_cast[]
  saved_by     watchlist_actors[]
  awards       actor_awards[]

  @@index([name], map: "idx_actors_name")
}

/// รางวัลที่ดาราได้รับ จาก Wikidata (P166 award received) — 1 แถว = รางวัล 1 ครั้ง
model actor_awards {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  actor_id   Int     @db.UnsignedInt
  /// Q-id ของรางวัลใน Wikidata เช่น Q103916 (Academy Award for Best Actor)
  award_qid  String  @db.VarChar(20)
  name_en    String  @db.VarChar(255)
  /// ชื่อภาษาไทยจาก Wikidata (มีเฉพาะบางรางวัล)
  name_th    String? @db.VarChar(255)
  /// ปีที่ได้รับ (qualifier P585) — null = Wikidata ไม่ระบุ
  year       Int?    @db.SmallInt
  /// ผลงานที่ได้รับรางวัล (qualifier P1686) ชื่อภาษาอังกฤษ
  for_work   String? @db.VarChar(255)
  actor      actors  @relation(fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([actor_id], map: "idx_actor_awards_actor")
}

model movies {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  /// รหัสภาพยนตร์ใน TMDB — หนึ่งเรื่องมีแถวเดียว ไม่ว่าจะมีดารากี่คน
  tmdb_id        Int?         @unique(map: "uq_movies_tmdb") @db.UnsignedInt
  title          String       @db.VarChar(200)
  release_year   Int?         @db.UnsignedSmallInt
  genre          String?      @db.VarChar(100)
  /// รายได้ทั่วโลก (ล้านดอลลาร์) — null = ไม่ทราบ (ไม่ใช่ 0)
  box_office_mil Decimal?     @db.Decimal(10, 2)
  rating         Decimal?     @db.Decimal(3, 1)
  poster_url     String?      @db.VarChar(500)
  /// ภาพแนวนอนสำหรับ hero / หน้ารายละเอียด
  backdrop_url   String?      @db.VarChar(500)
  overview       String?      @db.Text
  /// เรื่องย่อภาษาอังกฤษจาก TMDB (ใช้ตอนผู้ชมเลือกภาษา EN)
  overview_en    String?      @db.Text
  /// ความยาว (นาที)
  runtime        Int?         @db.UnsignedSmallInt
  /// เรทของสหรัฐฯ เช่น PG-13, R
  certification  String?      @db.VarChar(10)
  /// YouTube video key ของตัวอย่างหนังทางการ
  trailer_key    String?      @db.VarChar(20)
  release_date   DateTime?    @db.Date
  /// รหัสภาษา ISO 639-1 เช่น en, ko
  original_language String?   @db.VarChar(5)
  /// ความนิยมใน TMDB (ใช้จัด "มาแรง")
  popularity     Decimal?     @db.Decimal(10, 3)
  vote_count     Int?         @db.UnsignedInt
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  cast           movie_cast[]
  saved_by       watchlist_movies[]
  reviews        movie_reviews[]
  providers      movie_providers[]

  @@index([title], map: "idx_movies_title")
}

/// ดารา ↔ ภาพยนตร์ (many-to-many) พร้อมชื่อบทบาท
model movie_cast {
  movie_id      Int     @db.UnsignedInt
  actor_id      Int     @db.UnsignedInt
  role_name     String? @db.VarChar(120)
  /// ลำดับเครดิตใน TMDB (0 = นักแสดงนำ)
  billing_order Int     @default(0) @db.UnsignedSmallInt
  movie         movies  @relation(fields: [movie_id], references: [id], onDelete: Cascade, map: "fk_cast_movie")
  actor         actors  @relation(fields: [actor_id], references: [id], onDelete: Cascade, map: "fk_cast_actor")

  @@id([movie_id, actor_id])
  @@index([actor_id], map: "idx_cast_actor")
}

/// รีวิวจากผู้ชมบน TMDB (แสดงพร้อมเครดิตผู้เขียนและลิงก์ต้นทาง)
model movie_reviews {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  tmdb_id    String    @unique(map: "uq_reviews_tmdb") @db.VarChar(40)
  movie_id   Int       @db.UnsignedInt
  author     String    @db.VarChar(120)
  content    String    @db.Text
  /// คะแนนจากผู้เขียน (เต็ม 10) ถ้ามี
  rating     Decimal?  @db.Decimal(3, 1)
  url        String    @db.VarChar(500)
  written_at DateTime? @db.Timestamp(0)
  movie      movies    @relation(fields: [movie_id], references: [id], onDelete: Cascade, map: "fk_reviews_movie")

  @@index([movie_id], map: "idx_reviews_movie")
}

/// แพลตฟอร์มที่ดูได้ (ข้อมูล JustWatch ผ่าน TMDB)
model movie_providers {
  movie_id      Int     @db.UnsignedInt
  provider_id   Int     @db.UnsignedInt
  /// flatrate = สตรีมมิ่งแบบสมาชิก, rent = เช่า, buy = ซื้อ
  kind          String  @db.VarChar(10)
  provider_name String  @db.VarChar(80)
  logo_url      String? @db.VarChar(500)
  /// ประเทศของข้อมูล (TH ก่อน ถ้าไม่มีใช้ US)
  region        String  @db.VarChar(2)
  priority      Int     @default(0) @db.UnsignedSmallInt
  movie         movies  @relation(fields: [movie_id], references: [id], onDelete: Cascade, map: "fk_providers_movie")

  @@id([movie_id, provider_id, kind])
}

model users {
  id            Int        @id @default(autoincrement()) @db.UnsignedInt
  username      String     @unique(map: "uq_users_username") @db.VarChar(50)
  email         String     @unique(map: "uq_users_email") @db.VarChar(120)
  password_hash String     @db.VarChar(255)
  role          users_role @default(USER)
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  saved_movies  watchlist_movies[]
  saved_actors  watchlist_actors[]
}

/// รายการโปรด (ภาพยนตร์) ของผู้ใช้แต่ละคน
model watchlist_movies {
  user_id    Int      @db.UnsignedInt
  movie_id   Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_wlm_user")
  movie      movies   @relation(fields: [movie_id], references: [id], onDelete: Cascade, map: "fk_wlm_movie")

  @@id([user_id, movie_id])
  @@index([movie_id], map: "idx_wlm_movie")
}

/// รายการโปรด (ดารา) ของผู้ใช้แต่ละคน
model watchlist_actors {
  user_id    Int      @db.UnsignedInt
  actor_id   Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_wla_user")
  actor      actors   @relation(fields: [actor_id], references: [id], onDelete: Cascade, map: "fk_wla_actor")

  @@id([user_id, actor_id])
  @@index([actor_id], map: "idx_wla_actor")
}

enum users_role {
  ADMIN
  USER
}
